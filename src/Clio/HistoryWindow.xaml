<Window x:Class="Clio.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clio history"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        MinWidth="260" MinHeight="200"
        Width="330" Height="420">

    <Border Background="{StaticResource BgRaised}" BorderBrush="{StaticResource AccentDim}"
            BorderThickness="1" CornerRadius="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Rectangle Grid.RowSpan="4" Fill="{StaticResource Scanlines}" IsHitTestVisible="False" />

            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Rectangle Width="2" Height="10" Fill="{StaticResource Accent}" Margin="0,0,7,0" />
                    <TextBlock Text="CLIO  /  HISTORY" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                               Foreground="{StaticResource Accent}" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,6,0"
                        Click="Close_Click" AutomationProperties.Name="Close history" Width="20">
                    <Path Data="M 1,1 L 8,8 M 8,1 L 1,8" StrokeThickness="1.2" Width="9" Height="9"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Rectangle Height="1" VerticalAlignment="Bottom" Margin="12,0" Fill="{StaticResource Rule}" />
            </Grid>

            <TextBlock x:Name="Sub" Grid.Row="1" Margin="14,8,14,6" FontFamily="{StaticResource UiFont}" FontSize="10.5"
                       Foreground="{StaticResource TextLow}" TextWrapping="Wrap" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,0,4,0">
                <StackPanel x:Name="List" Margin="0,0,6,0" />
            </ScrollViewer>

            <TextBlock x:Name="Empty" Grid.Row="2" Text="Nothing erased." Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextFaint}" />

            <Grid Grid.Row="3" Margin="14,8,14,12">
                <Button x:Name="EmptyButton" Style="{StaticResource DangerButton}" Content="EMPTY HISTORY"
                        HorizontalAlignment="Right" Click="EmptyAll_Click" AutomationProperties.Name="Empty history" />
            </Grid>
        </Grid>
    </Border>
</Window>
