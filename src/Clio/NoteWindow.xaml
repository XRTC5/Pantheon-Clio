<Window x:Class="Clio.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clio note"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        MinWidth="170" MinHeight="120"
        Width="260" Height="240">

    <!--
        ResizeMode is NoResize because WPF's own resize handling assumes a
        frame this window does not have. Resizing comes from Placer answering
        WM_NCHITTEST on the rim, which Windows then drives natively.

        AllowsTransparency is what lets the erase dissolve show the desktop
        through the holes. It forces software rendering, which Clio uses for
        the whole process anyway (see App.xaml.cs).
    -->

    <Border x:Name="Shell" Background="{StaticResource NoteBg}" CornerRadius="3"
            BorderBrush="{DynamicResource NoteAccentSoft}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Scanlines and a faint wash from the top: the projection. -->
            <Rectangle Grid.RowSpan="4" Fill="{StaticResource Scanlines}" IsHitTestVisible="False" />
            <Rectangle Grid.RowSpan="4" Fill="{DynamicResource NoteWash}" IsHitTestVisible="False" />

            <!-- ======================================================= header -->
            <Grid x:Name="Header" Background="Transparent" Cursor="SizeAll"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" ClipToBounds="True">
                    <Rectangle Width="2" Height="10" Fill="{DynamicResource NoteAccent}" Margin="0,0,7,0" />
                    <TextBlock x:Name="Serial" Text="REC 001" FontFamily="{StaticResource MonoFont}"
                               FontSize="9.5" Foreground="{DynamicResource NoteAccent}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Stamp" Text="" FontFamily="{StaticResource MonoFont}" Margin="8,0,0,0"
                               FontSize="9" Foreground="{StaticResource TextLow}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,5,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="New_Click" ToolTip="New note (Ctrl+N)"
                            AutomationProperties.Name="New note" Width="20">
                        <Path Data="M 4,0 L 4,8 M 0,4 L 8,4" StrokeThickness="1.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <ToggleButton x:Name="FormatToggle" Style="{StaticResource IconToggle}" Width="22"
                                  Checked="Format_Click" Unchecked="Format_Click" ToolTip="Text formatting" AutomationProperties.Name="Format">
                        <TextBlock Text="Aa" FontFamily="{StaticResource UiFont}" FontSize="10" FontWeight="SemiBold" />
                    </ToggleButton>
                    <Button x:Name="ColorButton" Style="{StaticResource IconButton}" Click="Color_Click"
                            ToolTip="Colour" AutomationProperties.Name="Colour" Width="24">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource NoteAccent}" />
                            <Path Data="M 0,0 L 2.5,2.5 L 5,0" Margin="3,1,0,0" StrokeThickness="1"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="DrawToggle" Style="{StaticResource IconToggle}" Width="20"
                                  Checked="Draw_Click" Unchecked="Draw_Click" ToolTip="Doodle (Ctrl+D)" AutomationProperties.Name="Doodle">
                        <Path Data="M 1,11 L 3,7 L 9,1 L 11,3 L 5,9 Z M 3,7 L 5,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.1" StrokeLineJoin="Round" Width="12" Height="12" />
                    </ToggleButton>
                    <Button Style="{StaticResource IconButton}" Click="Erase_Click" ToolTip="Erase this note"
                            AutomationProperties.Name="Erase note" Width="20">
                        <Path Data="M 1,1 L 8,8 M 8,1 L 1,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" Width="9" Height="9" />
                    </Button>
                </StackPanel>

                <!-- A rule that fades out across the note, not a hard divider. -->
                <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Margin="10,0,10,0"
                           Fill="{DynamicResource NoteRule}" />
            </Grid>

            <!-- ================================================== format bar -->
            <!-- Folded away until Aa is pressed. Every shortcut works without it. -->
            <WrapPanel x:Name="FormatBar" Grid.Row="1" Visibility="Collapsed" Margin="8,5,8,0">
                <Button x:Name="FontButton" Style="{StaticResource IconButton}" Width="92" Click="Font_Click"
                        ToolTip="Font" AutomationProperties.Name="Font" HorizontalContentAlignment="Stretch">
                    <DockPanel Margin="5,0" Width="80">
                        <Path DockPanel.Dock="Right" Data="M 0,0 L 2.5,2.5 L 5,0" StrokeThickness="1" VerticalAlignment="Center"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock x:Name="FontLabel" Text="Segoe UI" FontSize="10" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
                <Button x:Name="SizeButton" Style="{StaticResource IconButton}" Width="38" Click="Size_Click" Margin="2,0,4,0"
                        ToolTip="Font size (Ctrl+Shift+. and Ctrl+Shift+,)" AutomationProperties.Name="Size">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SizeLabel" Text="10" FontSize="10" FontFamily="{StaticResource MonoFont}" />
                        <Path Data="M 0,0 L 2.5,2.5 L 5,0" Margin="4,1,0,0" StrokeThickness="1" VerticalAlignment="Center"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="BoldToggle" Style="{StaticResource IconToggle}" Checked="Bold_Click" Unchecked="Bold_Click"
                              ToolTip="Bold (Ctrl+B)" AutomationProperties.Name="Bold">
                    <TextBlock Text="B" FontWeight="Bold" FontSize="11" />
                </ToggleButton>
                <ToggleButton x:Name="ItalicToggle" Style="{StaticResource IconToggle}" Checked="Italic_Click" Unchecked="Italic_Click"
                              ToolTip="Italic (Ctrl+I)" AutomationProperties.Name="Italic">
                    <TextBlock Text="I" FontStyle="Italic" FontSize="11" FontFamily="Georgia" />
                </ToggleButton>
                <ToggleButton x:Name="UnderlineToggle" Style="{StaticResource IconToggle}" Checked="Underline_Click" Unchecked="Underline_Click"
                              ToolTip="Underline (Ctrl+U)" AutomationProperties.Name="Underline">
                    <TextBlock Text="U" TextDecorations="Underline" FontSize="11" />
                </ToggleButton>
                <ToggleButton x:Name="StrikeToggle" Style="{StaticResource IconToggle}" Checked="Strike_Click" Unchecked="Strike_Click"
                              ToolTip="Strikethrough (Alt+Shift+5)" AutomationProperties.Name="Strikethrough">
                    <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="11" />
                </ToggleButton>
                <Button Style="{StaticResource IconButton}" Click="Super_Click" ToolTip="Superscript (Ctrl+.)"
                        AutomationProperties.Name="Superscript">
                    <TextBlock FontSize="10">x<Run Text="2" BaselineAlignment="Superscript" FontSize="7" /></TextBlock>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="Sub_Click" ToolTip="Subscript (Ctrl+,)"
                        AutomationProperties.Name="Subscript">
                    <TextBlock FontSize="10">x<Run Text="2" BaselineAlignment="Subscript" FontSize="7" /></TextBlock>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="Bullets_Click" ToolTip="Bulleted list (Ctrl+Shift+8)"
                        AutomationProperties.Name="Bullets">
                    <Path Data="M 0,1 L 1.5,1 M 3.5,1 L 10,1 M 0,4.5 L 1.5,4.5 M 3.5,4.5 L 10,4.5 M 0,8 L 1.5,8 M 3.5,8 L 10,8"
                          StrokeThickness="1.3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Click="Numbers_Click" ToolTip="Numbered list (Ctrl+Shift+7)"
                        AutomationProperties.Name="Numbers">
                    <TextBlock Text="1." FontSize="10" FontFamily="{StaticResource MonoFont}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Click="Checklist_Click" ToolTip="Checklist (Ctrl+Shift+9)"
                        AutomationProperties.Name="Checklist">
                    <Grid Width="10" Height="10">
                        <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" />
                        <Path Data="M 2.2,5.2 L 4.2,7.2 L 7.8,2.8" StrokeThickness="1.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Grid>
                </Button>
                <Button x:Name="SymbolButton" Style="{StaticResource IconButton}" Click="Symbols_Click"
                        ToolTip="Maths and special characters" AutomationProperties.Name="Symbols">
                    <TextBlock Text="&#x03A9;" FontSize="11" />
                </Button>
                <Button Style="{StaticResource IconButton}" Click="Clear_Click" ToolTip="Clear formatting (Ctrl+\)"
                        AutomationProperties.Name="Clear formatting">
                    <TextBlock FontSize="10"><Run Text="T" /><Run Text="x" FontSize="7" /></TextBlock>
                </Button>
            </WrapPanel>

            <!-- ========================================================= body -->
            <Grid x:Name="Body" Grid.Row="2" Margin="10,6,6,8">
                <TextBlock x:Name="Placeholder" Text="record something.  /todo for a checkbox"
                           FontFamily="{StaticResource UiFont}" FontSize="13.33"
                           Foreground="{StaticResource TextFaint}" IsHitTestVisible="False" />

                <RichTextBox x:Name="Editor" AutomationProperties.Name="Note text" Background="Transparent"
                             BorderThickness="0" Padding="0"
                             Foreground="{StaticResource TextHi}" CaretBrush="{DynamicResource NoteAccent}"
                             SelectionBrush="{DynamicResource NoteAccent}" SelectionOpacity="0.3"
                             AcceptsReturn="True" AcceptsTab="True" UndoLimit="60" IsDocumentEnabled="False"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged"
                             PreviewMouseLeftButtonDown="Editor_PreviewMouseDown">
                    <RichTextBox.Template>
                        <ControlTemplate TargetType="RichTextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                        </ControlTemplate>
                    </RichTextBox.Template>
                </RichTextBox>

                <!-- InkCanvas goes here, created only for a note that is drawn on. -->
                <Grid x:Name="InkHost" />
            </Grid>

            <!-- ================================================== draw toolbar -->
            <Border x:Name="DrawBar" Grid.Row="3" Visibility="Collapsed" Margin="8,0,8,7"
                    BorderBrush="{StaticResource Rule}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel x:Name="Swatches" Orientation="Horizontal" DockPanel.Dock="Left" />
                    <ToggleButton x:Name="EraserToggle" Style="{StaticResource IconToggle}" Margin="4,0,0,0"
                                  Checked="Eraser_Click" Unchecked="Eraser_Click" ToolTip="Erase strokes" DockPanel.Dock="Left">
                        <Path Data="M 1,8 L 6,3 L 9,6 L 6,9 L 3,9 Z" StrokeThickness="1.1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </ToggleButton>
                    <Button Style="{StaticResource TextButton}" Content="DONE" Padding="8,2" FontSize="9"
                            Click="Draw_Done" DockPanel.Dock="Right" />
                    <Button Style="{StaticResource TextButton}" Content="CLEAR" Padding="8,2" FontSize="9"
                            Click="ClearInk_Click" DockPanel.Dock="Right" Margin="0,0,4,0" />
                </DockPanel>
            </Border>

            <!-- HUD corner brackets, over everything, never hit-tested. -->
            <Grid Grid.RowSpan="4" IsHitTestVisible="False" Margin="3">
                <Path Data="M 0,9 L 0,0 L 9,0" Stroke="{DynamicResource NoteAccent}" StrokeThickness="1"
                      HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Path Data="M 0,0 L 9,0 L 9,9" Stroke="{DynamicResource NoteAccent}" StrokeThickness="1"
                      HorizontalAlignment="Right" VerticalAlignment="Top" />
                <Path Data="M 0,0 L 0,9 L 9,9" Stroke="{DynamicResource NoteAccent}" StrokeThickness="1"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <Path Data="M 9,0 L 9,9 L 0,9" Stroke="{DynamicResource NoteAccent}" StrokeThickness="1"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                <!-- Resize grip. The hit area (16dip) is answered by Placer, not by this. -->
                <Path Data="M 8,1 L 1,8 M 8,4.5 L 4.5,8" Stroke="{DynamicResource NoteAccentSoft}" StrokeThickness="1"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" />
            </Grid>

            <!-- ====================================================== confirm -->
            <Border x:Name="Confirm" Grid.RowSpan="4" Visibility="Collapsed" Background="#F2070B10"
                    CornerRadius="3">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="ConfirmTitle" Text="ERASE REC 001?" FontFamily="{StaticResource MonoFont}"
                               FontSize="11" Foreground="{StaticResource TextHi}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ConfirmSub" Text="Kept in History for 5 days." FontFamily="{StaticResource UiFont}" FontSize="10.5"
                               Foreground="{StaticResource TextLow}" HorizontalAlignment="Center" Margin="0,4,0,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource TextButton}" Content="KEEP" Click="Keep_Click" AutomationProperties.Name="Keep" Margin="0,0,8,0" />
                        <Button Style="{StaticResource DangerButton}" Content="ERASE" Click="ConfirmErase_Click" AutomationProperties.Name="Confirm erase" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
