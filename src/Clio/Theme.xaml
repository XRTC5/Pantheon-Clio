<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--
        Argus's palette and Argus's rule: solid fills, 1px rules, type. No blur,
        no drop shadow, no storyboard, because these windows sit on screen all
        day and every one of those forces a repaint through an intermediate
        surface. The hologram is in the cyan rules, the corner brackets and a
        static scanline tile, all of which cost nothing once drawn.

        The only motion in Clio is stowing, releasing and the erase dissolve,
        and each runs for well under a second and then stops.
    -->

    <SolidColorBrush x:Key="Bg"        Color="#070B10" po:Freeze="True" />
    <SolidColorBrush x:Key="BgRaised"  Color="#0C1218" po:Freeze="True" />
    <SolidColorBrush x:Key="NoteBg"    Color="#F00A1017" po:Freeze="True" />
    <SolidColorBrush x:Key="Rule"      Color="#16202B" po:Freeze="True" />
    <SolidColorBrush x:Key="RuleSoft"  Color="#101823" po:Freeze="True" />
    <SolidColorBrush x:Key="Accent"    Color="#22D3EE" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentDim" Color="#0E4A56" po:Freeze="True" />
    <SolidColorBrush x:Key="TextHi"    Color="#C9D8E6" po:Freeze="True" />
    <SolidColorBrush x:Key="TextMid"   Color="#7C93A8" po:Freeze="True" />
    <SolidColorBrush x:Key="TextLow"   Color="#4C6076" po:Freeze="True" />
    <SolidColorBrush x:Key="TextFaint" Color="#33445A" po:Freeze="True" />
    <SolidColorBrush x:Key="Danger"    Color="#FF5C5C" po:Freeze="True" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- One 1px line every 3px at a few percent alpha. A tile brush is drawn
         once and cached; it reads as a projection without costing a frame. -->
    <DrawingBrush x:Key="Scanlines" TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute"
                  Stretch="None" po:Freeze="True">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#0CFFFFFF">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,4,1" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ========================================================== buttons -->

    <!-- Quiet until hovered; the accent comes from the note it sits on. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextLow}" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#0F1922" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NoteAccentSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource NoteAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextLow}" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#0F1922" />
                            <Setter Property="Foreground" Value="{DynamicResource NoteAccent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#0B2B33" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NoteAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource NoteAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dropdown row: flat until hovered. -->
    <Style x:Key="PickRow" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="2" Padding="8,4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#0F1922" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off switch for settings: a track and a knob, accent when on. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="30" Height="16" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="8" BorderThickness="1"
                                Background="#0C1218" BorderBrush="{StaticResource Rule}" />
                        <Ellipse x:Name="Knob" Width="10" Height="10" Margin="3,0"
                                 HorizontalAlignment="Left" Fill="{StaticResource TextLow}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#0B2B33" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
        <Setter Property="Foreground" Value="{StaticResource TextMid}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="2" BorderThickness="1"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#0F1922" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource NoteAccent}" />
                            <Setter Property="Foreground" Value="{DynamicResource NoteAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Erase is red only when hovered: obvious at the moment of pressing it. -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="2" BorderThickness="1"
                            Background="Transparent" BorderBrush="#4A2A2E"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="#C07070"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#2A1114" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Danger}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======================================================== scrollbar -->
    <!-- Argus's thin rule: the thumb is narrowed because the ScrollViewer sets
         the bar's own width as a local value no style can beat. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#25384A" CornerRadius="2"
                                                Width="3" HorizontalAlignment="Right" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                        </Track.IncreaseRepeatButton>
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                        </Track.DecreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================= menu -->
    <!-- The stock menu is a pale grey box; next to these windows it reads as
         a different program. -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource BgRaised}" BorderBrush="{StaticResource AccentDim}"
                            BorderThickness="1" CornerRadius="2" Padding="0,4" MinWidth="180">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource TextHi}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Background="Transparent" Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Text="&#x25C6;" FontSize="8" VerticalAlignment="Center"
                                       Foreground="{StaticResource Accent}" Visibility="Hidden" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#0F1922" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Greyed out, e.g. "Bring to front" on a picture already on top. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{StaticResource Rule}" Margin="0,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
